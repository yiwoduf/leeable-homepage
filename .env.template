# Server-side secrets for api/ Vercel Functions. Never prefix with VITE_ (that exposes values to the client bundle).

# OpenAI API key — platform.openai.com → API keys
OPENAI_API_KEY=

# Upstash Redis REST URL — console.upstash.com → your Redis DB → REST API
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token — console.upstash.com → your Redis DB → REST API
UPSTASH_REDIS_REST_TOKEN=
